#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
// conversion of swiss keycodes
#include "keymap_swiss_de.h"

// custom layer names
#define BASE 0
#define SYM  1
#define NAV  2
#define NMBR 3
#define FN   4

// custom combinations
#define SYM_SPC &lt SYM SPACE // tap: space; hold: sym-layer
#define NAV_BSPC &lt NAV BSPC // tap: backspace; hold: nav-layer
#define CTL_TAB &mt LCTRL TAB // tap: tab; hold: left-ctrl
#define SFT_RET &mt LSHFT RET // tap: return; hold: left-shift
#define WIN_L LG(L)
#define NEXT_TB LC(TAB)
#define PREV_TB LC(LS(TAB))


/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6    |  7    |  8    |  9   |   0   | WIN_L |
// |  CAPS |  Q  |  W  |  E   |  R   |  T   |                   |  Z    |  U    |  I    |  O   |   P   |   ~   |
// |  SHFT |  A  |  S  |  D   |  F   |  G   |                   |  H    |  J    |  K    |  L   |   :   |   /   |
// |  GUI  |  Y  |  X  |  C   |  V   |  B   |   "{"  |  |  "}"  |  N    |  M    |  ,    |  .   |   -   |       |
//                     | ALT  | GUI  |SPC/L1|  SPACE |  | ENTER |BSPC/L2| BSPC  | GUI   |
            display-name = "Base";
            bindings = <
&kp ESC   &kp N1    &kp N2 &kp N3   &kp N4   &kp N5                          &kp N6    &kp N7     &kp N8      &kp N9     &kp N0      WIN_L
&kp CAPS  &kp Q     &kp W  &kp E    &kp R    &kp T                           &kp CH_Z  &kp U      &kp I       &kp O      &kp P       &kp CH_TILD
&kp LSHFT &kp A     &kp S  &kp D    &kp F    &kp G                           &kp H     &kp J      &kp K       &kp L      &kp CH_COLN &kp CH_SLSH
&kp LGUI  &kp CH_Y  &kp X  &kp C    &kp V    &kp B   &kp CH_LCBR &kp CH_RCBR &kp N     &kp M      &kp CH_COMM &kp CH_DOT &kp CH_MINS &trans
                           &kp LALT &kp LGUI SYM_SPC CTL_TAB     SFT_RET     NAV_BSPC  &kp BSPC   &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
// ---------------------------------------------------------------------------------------------
// |  _  | BT1 | BT2 | BT3 | BT4 | BT5 |                   |BTCLR|     |     |     |     |     |
// |     |  +  |  "  |  *  |  $  |  %  |                   |  &  |  /  |  (  |  )  |  =  |     |
// |  ^  |  '  |  !  |  ?  |  @  |  #  |                   |  |  |  \  |  {  |  }  |     |     |
// |     |     |  <  |  >  |  ´  |  `  |        |  |       |  ¨  |     |  [  |  ]  |     |     |
//                   |     |     |     |        |  |       |     |     |     |
            display-name = "Lower";
            bindings = <
&kp CH_UNDS &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                    &bt BT_CLR  &trans      &trans      &trans      &trans     &trans
&trans      &kp CH_PLUS  &kp CH_DQUO  &kp CH_ASTR  &kp CH_DLR   &kp CH_PERC                     &kp CH_AMPR &kp CH_SLSH &kp CH_LPRN &kp CH_RPRN &kp CH_EQL &trans
&kp CH_CIRC &kp CH_QUOT  &kp CH_EXLM  &kp CH_QUES  &kp CH_AT    &kp CH_HASH                     &kp CH_PIPE &kp CH_BSLS &kp CH_LCBR &kp CH_RCBR &kp RPAR   &trans
&trans      &trans       &kp CH_LABK  &kp CH_RABK  &kp CH_ACUT  &kp CH_GRV   &trans   &trans    &kp CH_DIAE &trans      &kp CH_LBRC &kp CH_RBRC &kp RBRC   &trans
                                      &trans       &trans       &trans       &trans   &trans    &trans      &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |     |     |      |      |      |                   | PGUP |  HOME |   ^   |  END |  INS  |       |
// |       |     |     |      |      |      |                   | PGDN |  <-   |   v   |  ->  |  DEL  |       |
// |       |     |     |      |      |      |        |  |       |      |PREV_TB|NEXT_TB|      |       |       |
//                     |      |      |      |        |  |       |      |       |       |
            display-name = "Raise";
            bindings = <
&trans &trans &trans &trans &trans &trans                       &trans    &trans   &trans   &trans    &trans  &trans
&trans &trans &trans &trans &trans &trans                       &kp PG_UP &kp HOME &kp UP   &kp END   &kp INS &trans
&trans &trans &trans &trans &trans &trans                       &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &kp DEL &trans
&trans &trans &trans &trans &trans &trans    &trans   &trans    &trans    PREV_TB  NEXT_TB  &trans    &trans  &trans
                     &trans &trans &trans    &trans   &trans    &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
