#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
// conversion of swiss keycodes
#include "keymap_swiss_de.h"
// custom hold-tap behavior definitions
#include "hold_tap_behaviors.dtsi"
// mouse emulation
#include <dt-bindings/zmk/pointing.h>

// custom layer names
#define BASE  0
#define SYM   1
#define NAV   2
#define NMBR  3
#define FN    4
#define MOUSE 5

// custom combinations
#define SYM_SPC &lt SYM SPACE // tap: space; hold: sym-layer
#define NAV_BSPC &lt NAV BSPC // tap: backspace; hold: nav-layer
#define CTL_TAB &ht LCTRL TAB // tap: tab; hold: left-ctrl
#define SFT_RET &ht LSHFT RET // tap: return; hold: left-shift
#define WIN_L &kp LG(L)
#define NEXT_TB &kp LC(TAB)
#define PREV_TB &kp LC(LS(TAB))
#define ALT_Y &ht LALT CH_Y

// custom hold-taps for "umlaute" and others
#define HT_A &ht CH_ADIA A
#define HT_O &ht CH_ODIA O
#define HT_U &ht CH_UDIA U
#define HT_COLN &ht CH_SCLN CH_COLN

// home row mods
// left home row
#define HR_LALT &ht LALT S // tap: S; hold: left-alt
#define HR_LSHFT &ht LSHFT D // tap: D; hold: left-shift
#define HR_LCTRL &ht LCTRL F // tap F; hold: left-ctrl
// right home row
#define HR_RALT &ht RALT L // tap: L; hold: right-alt
#define HR_RSHFT &ht RSHFT K // tap: K; hold: right-shift
#define HR_RCTRL &ht RCTRL J // tap J; hold: right-ctrl

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6    |  7    |  8    |  9   |   0   | WIN_L |
// |  CAPS |  Q  |  W  |  E   |  R   |  T   |                   |  Z    |  U    |  I    |  O   |   P   |   ~   |
// |  SHFT |  A  |  S  |  D   |  F   |  G   |                   |  H    |  J    |  K    |  L   |  :/;  |   /   |
// |  GUI  |ALT/Y|  X  |  C   |  V   |  B   |   "{"  |  |  "}"  |  N    |  M    |  ,    |  .   |   -   |       |
//                     |  L5  |  L3  |SPC/L1| CTL/TAB|  |SFT/RET|BSPC/L2|  L4   |       |
            display-name = "Base";
            bindings = <
&kp ESC   &kp N1 &kp N2  &kp N3    &kp N4   &kp N5                          &kp N6    &kp N7   &kp N8      &kp N9     &kp N0      WIN_L
&kp CAPS  &kp Q  &kp W   &kp E     &kp R    &kp T                           &kp CH_Z  HT_U     &kp I       HT_O       &kp P       &kp CH_TILD
&kp LSHFT HT_A   HR_LALT HR_LSHFT  HR_LCTRL &kp G                           &kp H     HR_RCTRL HR_RSHFT    HR_RALT    HT_COLN     &kp CH_SLSH
&kp LGUI  ALT_Y  &kp X   &kp C     &kp V    &kp B   &kp CH_LCBR &kp CH_RCBR &kp N     &kp M    &kp CH_COMM &kp CH_DOT &kp CH_MINS &trans
                         &mo MOUSE &mo NMBR SYM_SPC CTL_TAB     SFT_RET     NAV_BSPC  &mo FN   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
// ---------------------------------------------------------------------------------------------
// |  _  | BT1 | BT2 | BT3 | BT4 | BT5 |                   |BTCLR|     |     |     |     |     |
// |     |  +  |  "  |  *  |  $  |  %  |                   |  &  |  /  |  (  |  )  |  =  |     |
// |  ^  |  '  |  !  |  ?  |  @  |  #  |                   |  |  |  \  |  {  |  }  |     |     |
// |     |     |  <  |  >  |  ´  |  `  |        |  |       |  ¨  |     |  [  |  ]  |     |     |
//                   |     |     |     |        |  |       |     |     |     |
            display-name = "Symbol";
            bindings = <
&kp CH_UNDS &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                    &bt BT_CLR  &trans      &trans      &trans      &trans     &trans
&trans      &kp CH_PLUS  &kp CH_DQUO  &kp CH_ASTR  &kp CH_DLR   &kp CH_PERC                     &kp CH_AMPR &kp CH_SLSH &kp CH_LPRN &kp CH_RPRN &kp CH_EQL &trans
&kp CH_CIRC &kp CH_QUOT  &kp CH_EXLM  &kp CH_QUES  &kp CH_AT    &kp CH_HASH                     &kp CH_PIPE &kp CH_BSLS &kp CH_LCBR &kp CH_RCBR &kp RPAR   &trans
&trans      &trans       &kp CH_LABK  &kp CH_RABK  &kp CH_ACUT  &kp CH_GRV   &trans   &trans    &kp CH_DIAE &trans      &kp CH_LBRC &kp CH_RBRC &kp RBRC   &trans
                                      &trans       &trans       &trans       &trans   &trans    &trans      &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |     |     |      |      |      |                   | PGUP |  HOME |   ^   |  END |  INS  |       |
// |       |     |     |      |      |      |                   | PGDN |  <-   |   v   |  ->  |  DEL  |       |
// |       |     |     |      |      |      |        |  |       |      |PREV_TB|NEXT_TB|      |       |       |
//                     |      |      |      |        |  |       |      |       |       |
            display-name = "Nav";
            bindings = <
&trans &trans &trans &trans &trans &trans                       &trans    &trans   &trans   &trans    &trans  &trans
&trans &trans &trans &trans &trans &trans                       &kp PG_UP &kp HOME &kp UP   &kp END   &kp INS &trans
&trans &trans &trans &trans &trans &trans                       &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &kp DEL &trans
&trans &trans &trans &trans &trans &trans    &trans   &trans    &trans    PREV_TB  NEXT_TB  &trans    &trans  &trans
                     &trans &trans &trans    &trans   &trans    &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_1 {
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |  =   |   7   |   8   |  9   |   *   |       |
// |       |     |     |      |      |      |                   |  -   |   4   |   5   |  6   |   +   |       |
// |       |     |     |      |      |      |                   |  _   |   1   |   2   |  3   |   /   |       |
// |       |     |     |      |      |      |        |  |       | BSPC |   0   |   .   |      |       |       |
//                     |      |      |      |        |  |       |      |       |       |
            display-name = "Numpad";
            bindings = <
&trans &trans &trans &trans &trans &trans                       &kp CH_EQL  &kp N7 &kp N8     &kp N9 &kp CH_ASTR &trans
&trans &trans &trans &trans &trans &trans                       &kp CH_MINS &kp N4 &kp N5     &kp N6 &kp CH_PLUS &trans
&trans &trans &trans &trans &trans &trans                       &kp CH_UNDS &kp N1 &kp N2     &kp N3 &kp CH_SLSH &trans
&trans &trans &trans &trans &trans &trans    &trans   &trans    &kp BSPC    &kp N0 &kp CH_DOT &trans &trans      &trans
                     &trans &trans &trans    &trans   &trans    &trans      &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_2 {
// ------------------------------------------------------------------------------------------------------------
// |       |     |  F9 |  F10 |  F11 |  F12 |                   |      |       |       |      |       |       |
// |       |     |  F5 |  F6  |  F7  |  F8  |                   |      |       |       |      |       |       |
// |       |     |  F1 |  F2  |  F3  |  F4  |                   |      |       |       |      |       |       |
// |       |     |     |      |      |      |        |  |       |      |       |       |      |       |       |
//                     |      |      |      |        |  |       |      |       |       |
            display-name = "FN";
            bindings = <
&trans &trans &kp F9 &kp F10 &kp F11 &kp F12                      &trans &trans &trans &trans &trans &trans
&trans &trans &kp F5 &kp F6  &kp F7  &kp F8                       &trans &trans &trans &trans &trans &trans
&trans &trans &kp F1 &kp F2  &kp F3  &kp F4                       &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans  &trans  &trans    &trans   &trans    &trans &trans &trans &trans &trans &trans
                     &trans  &trans  &trans    &trans   &trans    &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_3 {
// ------------------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                    |         |         |         |          |       |       |
// |       |     |     |      |      |      |                    | SCRL UP |SCRL LEFT| PNTR UP |SCRL RIGHT|       |       |
// |       |     |     |      |      |      |                    |SCRL DOWN|PNTR LEFT|PNTR DOWN|PNTR RIGHT|       |       |
// |       |     |     |      |      |      |        |  |        |         |         |         |          |       |       |
//                     |      |      |      |        |  |LEFT CLK|RIGHT CLK| MDL CLK |         |
            display-name = "Mouse";
            bindings = <
&trans &trans &trans &trans &trans &trans                    &trans         &trans          &trans         &trans          &trans &trans
&trans &trans &trans &trans &trans &trans                    &msc SCRL_UP   &msc SCRL_LEFT  &mmv MOVE_UP   &msc SCRL_RIGHT &trans &trans
&trans &trans &trans &trans &trans &trans                    &msc SCRL_DOWN &mmv MOVE_LEFT  &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans &trans
&trans &trans &trans &trans &trans &trans &trans   &trans    &trans         &trans          &trans         &trans          &trans &trans
                     &trans &trans &trans &trans   &mkp LCLK &mkp RCLK      &mkp MCLK       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
